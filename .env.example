# Скопируйте в .env. Значения ниже — для запуска backend на хосте против сервисов из docker-compose.
# Вложенные настройки задаются через двойное подчёркивание.
ENVIRONMENT=local
SECRET_KEY=change-me

APP_URL=http://localhost:8501
SITES_BASE_DOMAIN=events.skolhub.ru
CORS_ORIGINS=["http://localhost:8501","http://localhost:8502"]

DB__HOST=localhost
DB__PORT=8510
DB__USER=sk_events
DB__PASSWORD=sk_events
DB__NAME=sk_events

REDIS__HOST=localhost
REDIS__PORT=8511

STORAGE_DIR=./.data/files

# Локально — Mailpit. В UAT и PROD — Яндекс: smtp.yandex.ru, 465, SSL, логин skolstream@yandex.ru, пароль приложения.
SMTP__HOST=localhost
SMTP__PORT=8503
SMTP__USER=
SMTP__PASSWORD=
SMTP__USE_SSL=false
SMTP__SENDER=SK Events <skolstream@yandex.ru>

SKOLSTREAM__BASE_URL=
SKOLSTREAM__CLIENT_ID=
SKOLSTREAM__CLIENT_SECRET=
SKOLSTREAM__DIRECTORY_TOKEN=

# Yandex SmartCaptcha на запросе ссылки для входа (без ключей капча выключена)
CAPTCHA__CLIENT_KEY=
CAPTCHA__SERVER_KEY=

# Свои домены лендингов: пусто — маршруты Traefik не пишутся (docs/domains.md)
SITES_CNAME_TARGET=sites.events.skolhub.ru
TRAEFIK_DYNAMIC_DIR=
